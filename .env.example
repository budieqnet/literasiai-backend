# LiterasiAI — Environment Configuration
# Salin file ini menjadi .env dan isi nilainya

FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=ganti-dengan-secret-key-anda

# Admin API key untuk /api/admin/download-methods
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Core API (opsional, meningkatkan rate limit)
CORE_API_KEY=

# NVIDIA Nemotron untuk klasifikasi (wajib bila fitur klasifikasi diaktifkan)
# Dapatkan key di https://build.nvidia.com
NVIDIA_API_KEY=
# Rotasi multi-key (opsional) — pakai salah satu format:
#   NVIDIA_API_KEYS=key1,key2,key3
#   NVIDIA_API_KEY_1=... / _2=... / _3=...
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT=60
NVIDIA_MAX_RETRIES=2
NVIDIA_MAX_TOKENS=512
NVIDIA_TEMPERATURE=0.2
NVIDIA_TOP_P=0.9

# Cache klasifikasi in-memory (per proses)
# 1 = aktif, 0 = nonaktif
NVIDIA_CACHE_ENABLED=1
NVIDIA_CACHE_TTL=86400
NVIDIA_CACHE_SIZE=2048

# MySQL — penyimpanan hasil pencarian (opsional; app tetap jalan tanpa DB)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=literasiai
MYSQL_CONNECT_TIMEOUT=5

# Cache TTL dalam detik (default 10 menit)
CACHE_TTL=600
